---
import { getCollection, render } from 'astro:content';
import CommandPalette from '../../components/CommandPalette';
import FloatingGlass from '../../components/FloatingGlass';
import MobileGlassDock from '../../components/MobileGlassDock';
import ProgressGlass from '../../components/ProgressGlass';
import { formatDate, postHref, postSlug, readingTime, sortPosts, toSearchItems } from '../../lib/posts';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));

  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      previousPost: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const allPosts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const searchItems = toSearchItems(allPosts);
const { Content, headings } = await render(post);
const heroImage = post.data.image || '/images/blog/hero-ptilopsis.jpeg';
const sectionHeadings = headings
  .filter((heading) => heading.depth <= 2)
  .slice(0, 5)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text.length > 12 ? `${heading.text.slice(0, 12)}...` : heading.text,
  }));
const progressSections = [
  { id: 'article-top', label: 'Intro' },
  { id: 'article-body', label: 'Article' },
  ...sectionHeadings,
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.data.description || post.data.title} />
    <title>{post.data.title} | Mugaaaaa's Blog</title>
  </head>
  <body>
    <div id="top" class="paper-grid min-h-screen overflow-x-hidden">
      <FloatingGlass client:load />
      <MobileGlassDock client:load />
      <CommandPalette posts={searchItems} client:load />
      <ProgressGlass
        title="Reading"
        sections={progressSections}
        details={[
          { label: 'Date', value: formatDate(post.data.published) },
          { label: 'Read', value: `${readingTime(post)} min` },
          { label: 'Type', value: post.data.category ?? 'Note' },
        ]}
        links={[
          { label: 'All posts', href: '/posts/' },
          ...(nextPost ? [{ label: 'Newer', href: postHref(nextPost) }] : []),
          ...(previousPost ? [{ label: 'Older', href: postHref(previousPost) }] : []),
        ]}
        client:load
      />

      <header id="article-top" class="relative isolate min-h-[72svh] bg-stone-950 text-white">
        <img
          src={heroImage}
          alt=""
          class="absolute inset-0 -z-20 h-full w-full object-cover object-top"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.76),rgba(0,0,0,0.28)_54%,rgba(0,0,0,0.72))]"></div>
        <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-black/64 to-transparent"></div>

        <div class="mx-auto flex min-h-[72svh] max-w-6xl flex-col justify-end px-5 pb-10 pt-28 md:px-8 lg:px-10 lg:pr-48">
          <a href="/posts/" class="mb-6 inline-flex w-fit items-center border border-white/45 bg-white px-3 py-1.5 text-xs font-black uppercase leading-none text-black">
            Back to posts
          </a>
          <p class="mb-4 text-sm font-black uppercase tracking-[0.16em] text-white/72">
            {post.data.category ?? 'Note'} / {formatDate(post.data.published)} / {readingTime(post)} min read
          </p>
          <h1 class="max-w-5xl text-5xl font-black leading-[0.98] md:text-7xl lg:text-8xl">
            {post.data.title}
          </h1>
          {post.data.description && (
            <p class="mt-6 max-w-2xl text-xl font-bold leading-8 text-white/82">
              {post.data.description}
            </p>
          )}
        </div>
      </header>

      <main id="article-body" class="px-5 py-14 md:px-8 lg:px-10">
        <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[minmax(0,760px)_280px]">
          <article class="article-shell border border-stone-300 bg-[#fffdf8] px-5 py-8 md:px-8 md:py-10">
            <div class="mb-8 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="border border-stone-300 bg-stone-100 px-2 py-1 text-xs font-black uppercase text-stone-700">
                  {tag}
                </span>
              ))}
            </div>
            <div class="prose-content">
              <Content />
            </div>
          </article>

          <aside class="hidden lg:block">
            <div class="sticky top-28 grid gap-4">
              <section class="flat-card p-5">
                <p class="text-xs font-black uppercase tracking-[0.14em] text-stone-500">Outline</p>
                <div class="mt-4 grid gap-2">
                  {sectionHeadings.length > 0 ? (
                    sectionHeadings.map((heading) => (
                      <a href={`#${heading.id}`} class="rounded-full bg-stone-100 px-3 py-2 text-sm font-black text-stone-700 hover:bg-stone-200">
                        {heading.label}
                      </a>
                    ))
                  ) : (
                    <p class="text-sm font-semibold leading-6 text-stone-600">这篇文章还没有二级目录。</p>
                  )}
                </div>
              </section>

              <section class="flat-card bg-stone-950 p-5 text-white">
                <p class="text-xs font-black uppercase tracking-[0.14em] text-white/50">Adjacent</p>
                <div class="mt-4 grid gap-3">
                  {nextPost && (
                    <a href={postHref(nextPost)} class="block border border-white/15 p-3 hover:bg-white/10">
                      <p class="text-xs font-bold text-white/50">Newer</p>
                      <p class="mt-1 text-sm font-black leading-5">{nextPost.data.title}</p>
                    </a>
                  )}
                  {previousPost && (
                    <a href={postHref(previousPost)} class="block border border-white/15 p-3 hover:bg-white/10">
                      <p class="text-xs font-bold text-white/50">Older</p>
                      <p class="mt-1 text-sm font-black leading-5">{previousPost.data.title}</p>
                    </a>
                  )}
                </div>
              </section>
            </div>
          </aside>
        </div>
      </main>
    </div>
    <script>
      const copyText = async (text: string) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        document.body.append(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      };

      const enhanceCodeBlocks = () => {
        document.querySelectorAll<HTMLPreElement>('.prose-content pre').forEach((pre) => {
          if (pre.querySelector('.copy-code-button')) {
            return;
          }

          const code = pre.querySelector('code');
          if (!code) {
            return;
          }

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-code-button';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', 'Copy code');

          button.addEventListener('click', async () => {
            await copyText(code.textContent ?? '');
            button.textContent = 'Copied';
            button.dataset.copied = 'true';

            window.setTimeout(() => {
              button.textContent = 'Copy';
              delete button.dataset.copied;
            }, 1200);
          });

          pre.append(button);
        });
      };

      enhanceCodeBlocks();
      document.addEventListener('astro:page-load', enhanceCodeBlocks);
    </script>
  </body>
</html>
