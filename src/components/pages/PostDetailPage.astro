---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import CommandPalette from '../CommandPalette';
import FloatingGlass from '../FloatingGlass';
import MobileGlassDock from '../MobileGlassDock';
import ProgressGlass from '../ProgressGlass';
import heroSource from '../../assets/images/home/hero.jpeg';
import { getTranslations, localizedPath, type Locale } from '../../i18n/ui';
import { formatDate, postHref, readingTime, sortPosts, toSearchItems } from '../../lib/posts';
import '../../styles/global.css';

const { post, previousPost, nextPost } = Astro.props;
const locale = (Astro.props.locale ?? 'zh') as Locale;
const t = getTranslations(locale);
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const allPosts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const searchItems = toSearchItems(allPosts, locale);
const { Content, headings } = await render(post);
const isVerticalLayout = post.data.layout === 'vertical';
const fallbackHeroImage = await getImage({ src: heroSource, width: 1920, format: 'webp', quality: 78 });
const heroImage = post.data.image || fallbackHeroImage.src;
const sectionHeadings = headings
  .filter((heading) => heading.depth <= 2)
  .slice(0, 5)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text.length > 12 ? `${heading.text.slice(0, 12)}...` : heading.text,
  }));
const progressSections = [
  { id: 'article-top', label: t.postDetail.intro },
  { id: 'article-body', label: t.postDetail.article },
  ...sectionHeadings,
];
const copyCodeLabel = t.postDetail.copyCode;
const copiedCodeLabel = t.postDetail.copiedCode;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.data.description || post.data.title} />
    <title>{post.data.title} | Mugaaaaa's Blog</title>
  </head>
  <body>
    <div id="top" class:list={['paper-grid min-h-screen', isVerticalLayout ? 'vertical-post-root' : 'overflow-x-hidden']}>
      <FloatingGlass locale={locale} currentPath={currentPath} client:load />
      <MobileGlassDock locale={locale} client:load />
      <CommandPalette posts={searchItems} locale={locale} client:load />
      <ProgressGlass
        title={t.postDetail.reading}
        sections={progressSections}
        details={[
          { label: t.common.date, value: formatDate(post.data.published, locale) },
          { label: t.common.read, value: `${readingTime(post)} ${t.common.min.toLowerCase()}` },
          { label: t.common.type, value: post.data.category ?? t.common.note },
        ]}
        links={[
          { label: t.postDetail.allPosts, href: localizedPath(locale, '/posts/') },
          ...(nextPost ? [{ label: t.postDetail.newer, href: postHref(nextPost, locale) }] : []),
          ...(previousPost ? [{ label: t.postDetail.older, href: postHref(previousPost, locale) }] : []),
        ]}
        client:load
      />

      <header id="article-top" class="relative isolate min-h-[72svh] bg-stone-950 text-white">
        <img
          src={heroImage}
          alt=""
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover object-top"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.76),rgba(0,0,0,0.28)_54%,rgba(0,0,0,0.72))]"></div>
        <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-black/64 to-transparent"></div>

        <div class="mx-auto flex min-h-[72svh] max-w-6xl flex-col justify-end px-5 pb-10 pt-28 md:px-8 lg:px-10 lg:pr-48">
          <a href={localizedPath(locale, '/posts/')} class="post-back-link mb-6 inline-flex w-fit items-center border border-white/45 bg-white px-3 py-1.5 text-xs font-black uppercase leading-none">
            {t.postDetail.backToPosts}
          </a>
          <p class="mb-4 text-sm font-black uppercase tracking-[0.16em] text-white/72">
            {post.data.category ?? t.common.note} / {formatDate(post.data.published, locale)} / {t.common.minutesRead(readingTime(post))}
          </p>
          <h1 class="max-w-5xl text-5xl font-black leading-[0.98] md:text-7xl lg:text-8xl">
            {post.data.title}
          </h1>
          {post.data.description && (
            <p class="mt-6 max-w-2xl text-xl font-bold leading-8 text-white/82">
              {post.data.description}
            </p>
          )}
        </div>
      </header>

      <main id="article-body" class:list={['px-5 py-14 md:px-8 lg:px-10', isVerticalLayout && 'vertical-page-main']}>
        <div class:list={[
          isVerticalLayout
            ? 'vertical-page-shell mx-auto max-w-6xl'
            : 'mx-auto grid max-w-6xl gap-8 lg:grid-cols-[minmax(0,760px)_280px]',
        ]}>
          <article class:list={[
            'article-shell border border-stone-300 bg-[#fffdf8]',
            isVerticalLayout ? 'vertical-article-shell' : 'px-5 py-8 md:px-8 md:py-10',
          ]}>
            <div class="mb-8 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="border border-stone-300 bg-stone-100 px-2 py-1 text-xs font-black uppercase text-stone-700">
                  {tag}
                </span>
              ))}
            </div>
            <div class:list={['prose-content', isVerticalLayout && 'prose-content-vertical-page']}>
              <Content />
            </div>
          </article>

          {!isVerticalLayout && (
            <aside class="hidden lg:block">
              <div class="sticky top-28 grid gap-4">
                <section class="flat-card p-5">
                  <p class="text-xs font-black uppercase tracking-[0.14em] text-stone-500">{t.postDetail.outline}</p>
                  <div class="mt-4 grid gap-2">
                    {sectionHeadings.length > 0 ? (
                      sectionHeadings.map((heading) => (
                        <a href={`#${heading.id}`} class="rounded-full bg-stone-100 px-3 py-2 text-sm font-black text-stone-700 hover:bg-stone-200">
                          {heading.label}
                        </a>
                      ))
                    ) : (
                      <p class="text-sm font-semibold leading-6 text-stone-600">{t.postDetail.noOutline}</p>
                    )}
                  </div>
                </section>

                <section class="flat-card bg-stone-950 p-5 text-white">
                  <p class="text-xs font-black uppercase tracking-[0.14em] text-white/50">{t.postDetail.adjacent}</p>
                  <div class="mt-4 grid gap-3">
                    {nextPost && (
                      <a href={postHref(nextPost, locale)} class="block border border-white/15 p-3 hover:bg-white/10">
                        <p class="text-xs font-bold text-white/50">{t.postDetail.newer}</p>
                        <p class="mt-1 text-sm font-black leading-5">{nextPost.data.title}</p>
                      </a>
                    )}
                    {previousPost && (
                      <a href={postHref(previousPost, locale)} class="block border border-white/15 p-3 hover:bg-white/10">
                        <p class="text-xs font-bold text-white/50">{t.postDetail.older}</p>
                        <p class="mt-1 text-sm font-black leading-5">{previousPost.data.title}</p>
                      </a>
                    )}
                  </div>
                </section>
              </div>
            </aside>
          )}
        </div>
      </main>
    </div>
    <script define:vars={{ copyCodeLabel, copiedCodeLabel }}>
      const copyText = async (text) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        document.body.append(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      };

      const enhanceCodeBlocks = () => {
        document.querySelectorAll('.prose-content pre').forEach((pre) => {
          if (pre.querySelector('.copy-code-button')) {
            return;
          }

          const code = pre.querySelector('code');
          if (!code) {
            return;
          }

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-code-button';
          button.textContent = copyCodeLabel;
          button.setAttribute('aria-label', copyCodeLabel);

          button.addEventListener('click', async () => {
            await copyText(code.textContent ?? '');
            button.textContent = copiedCodeLabel;
            button.dataset.copied = 'true';

            window.setTimeout(() => {
              button.textContent = copyCodeLabel;
              delete button.dataset.copied;
            }, 1200);
          });

          pre.append(button);
        });
      };

      const isKana = (char) => /[\u3040-\u30ff\uff66-\uff9f]/u.test(char);
      const isAnnotationStart = (char) => ['(', '{', '[', '‹', '«'].includes(char);
      const bracketPairs = {
        '(': ')',
        '{': '}',
        '[': ']',
        '‹': '›',
        '«': '»',
      };

      const readBracket = (chars, start) => {
        const close = bracketPairs[chars[start]];
        if (!close) return null;

        const end = chars.indexOf(close, start + 1);
        if (end === -1) return null;

        return {
          content: chars.slice(start + 1, end).join(''),
          end,
          kind: chars[start],
        };
      };

      const readMultipleKanjiBase = (chars, start) => {
        const open = chars[start];
        if (open !== '‘' && open !== "'") return null;

        const close = open === '‘' ? '’' : "'";
        const end = chars.indexOf(close, start + 1);
        if (end === -1) return null;

        return {
          content: chars.slice(start + 1, end).join(''),
          end,
        };
      };

      const parseMultipleKanjiBase = (content) => {
        const chars = Array.from(content);
        const tokens = [];

        const attachKaeriToPreviousBase = (kaeri) => {
          for (let index = tokens.length - 1; index >= 0; index -= 1) {
            if (tokens[index].type === 'base') {
              tokens[index].kaeri = kaeri;
              return;
            }
          }
        };

        for (let index = 0; index < chars.length; index += 1) {
          const char = chars[index];
          const bracket = char === '[' ? readBracket(chars, index) : null;

          if (bracket) {
            attachKaeriToPreviousBase(bracket.content);
            index = bracket.end;
            continue;
          }

          if (char === '―' || char === '-') {
            tokens.push({ type: 'connector' });
            continue;
          }

          tokens.push({ type: 'base', value: char, kaeri: '' });
        }

        return tokens;
      };

      const appendKanbunBase = (node, base) => {
        Array.from(base).forEach((char) => {
          if (char === '―') {
            const dash = document.createElement('span');
            dash.className = 'kanbun-base-dash';
            dash.textContent = char;
            node.append(dash);
            return;
          }

          node.append(document.createTextNode(char));
        });
      };

      const createKanbunUnit = ({ base, furigana, okuri, kaeri, saidokuFurigana, saidokuOkuri }) => {
        const unit = document.createElement('span');
        unit.className = [
          'kanbun-unit',
          furigana && 'has-furigana',
          okuri && 'has-okuri',
          kaeri && 'has-kaeri',
          (saidokuFurigana || saidokuOkuri) && 'has-saidoku',
          saidokuOkuri && 'has-saidoku-okuri',
        ]
          .filter(Boolean)
          .join(' ');

        const baseNode = document.createElement('span');
        baseNode.className = 'kanbun-base';
        appendKanbunBase(baseNode, base);
        unit.append(baseNode);

        if (furigana) {
          const furiganaNode = document.createElement('span');
          furiganaNode.className = 'kanbun-furigana';
          furiganaNode.textContent = furigana;
          unit.append(furiganaNode);
        }

        if (okuri) {
          const okuriNode = document.createElement('span');
          okuriNode.className = 'kanbun-okuri';
          okuriNode.textContent = okuri;
          unit.append(okuriNode);
        }

        if (kaeri) {
          const kaeriNode = document.createElement('span');
          kaeriNode.className = 'kanbun-kaeri';
          Array.from(kaeri).forEach((char) => {
            const charNode = document.createElement('span');
            charNode.className = 'kanbun-kaeri-char';
            charNode.textContent = char;
            kaeriNode.append(charNode);
          });
          unit.append(kaeriNode);
        }

        if (saidokuFurigana || saidokuOkuri) {
          const saidokuNode = document.createElement('span');
          saidokuNode.className = 'kanbun-saidoku';

          if (saidokuFurigana) {
            const saidokuFuriganaNode = document.createElement('span');
            saidokuFuriganaNode.className = 'kanbun-saidoku-furigana';
            saidokuFuriganaNode.textContent = saidokuFurigana;
            saidokuNode.append(saidokuFuriganaNode);
          }

          if (saidokuOkuri) {
            const saidokuOkuriNode = document.createElement('span');
            saidokuOkuriNode.className = 'kanbun-saidoku-okuri';
            saidokuOkuriNode.textContent = saidokuOkuri;
            saidokuNode.append(saidokuOkuriNode);
          }

          unit.append(saidokuNode);
        }

        return unit;
      };

      const createKanbunMiddleNote = ({ furigana, hasConnector = true }) => {
        const note = document.createElement('span');
        note.className = [
          'kanbun-word-middle',
          furigana && 'has-word-furigana',
          hasConnector && 'has-word-connector',
        ]
          .filter(Boolean)
          .join(' ');
        note.setAttribute('aria-hidden', 'true');

        if (hasConnector) {
          const connector = document.createElement('span');
          connector.className = 'kanbun-word-middle-connector';
          note.append(connector);
        }

        if (furigana) {
          const furiganaNode = document.createElement('span');
          furiganaNode.className = 'kanbun-word-middle-furigana';
          furiganaNode.textContent = furigana;
          note.append(furiganaNode);
        }

        return note;
      };

      const createMultipleKanjiFragment = ({ tokens, furigana }) => {
        const fragment = document.createDocumentFragment();
        const hasConnector = tokens.some((token) => token.type === 'connector');
        let baseCount = 0;
        let didAttachFurigana = false;

        tokens.forEach((token) => {
          if (token.type === 'connector') {
            fragment.append(createKanbunMiddleNote({
              furigana: didAttachFurigana ? '' : furigana,
              hasConnector: true,
            }));
            didAttachFurigana = true;
            return;
          }

          fragment.append(createKanbunUnit({
            base: token.value,
            furigana: '',
            okuri: '',
            kaeri: token.kaeri,
          }));

          baseCount += 1;
          if (furigana && !hasConnector && !didAttachFurigana && baseCount === 1) {
            fragment.append(createKanbunMiddleNote({
              furigana,
              hasConnector: false,
            }));
            didAttachFurigana = true;
          }
        });

        return fragment;
      };

      const createKanbunPunctuation = (text) => {
        const punctuation = document.createElement('span');
        punctuation.className = 'kanbun-punctuation';
        punctuation.textContent = text;
        return punctuation;
      };

      const parseKanbunSource = (source) => {
        const fragment = document.createDocumentFragment();
        const chars = Array.from(source.trim());

        for (let index = 0; index < chars.length; index += 1) {
          let base = chars[index];
          if (!base || /\s/.test(base)) continue;

          if (isAnnotationStart(base)) {
            continue;
          }

          let multipleBaseTokens = null;
          let furigana = '';
          let okuri = '';
          let kaeri = '';
          let saidokuFurigana = '';
          let saidokuOkuri = '';

          if (base === '‘' || base === "'") {
            const multipleBase = readMultipleKanjiBase(chars, index);

            if (!multipleBase) continue;

            multipleBaseTokens = parseMultipleKanjiBase(multipleBase.content);
            index = multipleBase.end;
          }

          while (index + 1 < chars.length) {
            const next = chars[index + 1];

            if (isKana(next)) {
              okuri += next;
              index += 1;
              continue;
            }

            const bracket = isAnnotationStart(next) ? readBracket(chars, index + 1) : null;
            if (!bracket) break;

            if (bracket.kind === '(') {
              furigana = bracket.content;
            } else if (bracket.kind === '{') {
              okuri += bracket.content;
            } else if (bracket.kind === '[') {
              kaeri = bracket.content;
            } else if (bracket.kind === '‹') {
              saidokuFurigana = bracket.content;
            } else if (bracket.kind === '«') {
              saidokuOkuri += bracket.content;
            }

            index = bracket.end;
          }

          if (multipleBaseTokens) {
            fragment.append(createMultipleKanjiFragment({ tokens: multipleBaseTokens, furigana }));
          } else if (/[\p{Script=Han}々〻]/u.test(base)) {
            fragment.append(createKanbunUnit({ base, furigana, okuri, kaeri, saidokuFurigana, saidokuOkuri }));
          } else {
            fragment.append(createKanbunPunctuation(base));
          }
        }

        return fragment;
      };

      const enhanceKanbunSources = () => {
        document.querySelectorAll('.kanbun-source p').forEach((paragraph) => {
          if (paragraph.dataset.kanbunReady === 'true') {
            return;
          }

          const source = paragraph.textContent ?? '';
          paragraph.textContent = '';
          paragraph.append(parseKanbunSource(source));
          paragraph.dataset.kanbunReady = 'true';
        });
      };

      const normalizeWheelDelta = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) {
          return event.deltaY * 16;
        }

        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) {
          return event.deltaY * window.innerHeight;
        }

        return event.deltaY;
      };

      const enhanceVerticalWheelScroll = () => {
        document.querySelectorAll('.vertical-page-main').forEach((container) => {
          if (container.dataset.verticalWheelReady === 'true') {
            return;
          }

          let frame = 0;
          let velocity = 0;
          const friction = 0.82;
          const maxVelocity = 90;
          const minVelocity = 0.35;
          const speed = 0.32;

          const scrollWithMomentum = () => {
            container.scrollBy({
              left: velocity,
              behavior: 'auto',
            });
            velocity *= friction;

            if (Math.abs(velocity) > minVelocity) {
              frame = window.requestAnimationFrame(scrollWithMomentum);
              return;
            }

            velocity = 0;
            frame = 0;
          };

          container.addEventListener('wheel', (event) => {
            if (event.ctrlKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
              return;
            }

            event.preventDefault();
            const nextVelocity = velocity - normalizeWheelDelta(event) * speed;
            velocity = Math.max(-maxVelocity, Math.min(maxVelocity, nextVelocity));

            if (!frame) {
              frame = window.requestAnimationFrame(scrollWithMomentum);
            }
          }, { passive: false });

          container.dataset.verticalWheelReady = 'true';
        });
      };

      enhanceKanbunSources();
      enhanceCodeBlocks();
      enhanceVerticalWheelScroll();
      document.addEventListener('astro:page-load', enhanceKanbunSources);
      document.addEventListener('astro:page-load', enhanceCodeBlocks);
      document.addEventListener('astro:page-load', enhanceVerticalWheelScroll);
    </script>
  </body>
</html>
