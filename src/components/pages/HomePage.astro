---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import CommandPalette from '../CommandPalette';
import FloatingGlass from '../FloatingGlass';
import { LiquidGlass } from '../LiquidGlass';
import MobileGlassDock from '../MobileGlassDock';
import NowQueueGlass from '../NowQueueGlass';
import PostFilterGlass from '../PostFilterGlass';
import ProgressGlass from '../ProgressGlass';
import heroSource from '../../assets/images/home/hero.jpeg';
import latestPostsSource from '../../assets/images/home/latest-posts.jpg';
import volumeAnimeSource from '../../assets/images/home/volume-anime.jpg';
import volumeChoreSource from '../../assets/images/home/volume-chore.jpg';
import volumeLinguistsSource from '../../assets/images/home/volume-linguists.jpg';
import volumeMusicSource from '../../assets/images/home/volume-music.jpg';
import volumePaperNotesSource from '../../assets/images/home/volume-paper-notes.jpg';
import volumeTechnologySource from '../../assets/images/home/volume-technology.jpg';
import { getTranslations, localizedPath, type Locale } from '../../i18n/ui';
import { formatDate, postHref, readingTime, sortPosts, toSearchItems } from '../../lib/posts';
import '../../styles/global.css';

const locale = (Astro.props.locale ?? 'zh') as Locale;
const t = getTranslations(locale);
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const [
  heroImage,
  heroAnimeImage,
  heroMusicImage,
  latestPostsImage,
  volumePaperNotesImage,
  volumeAnimeImage,
  volumeLinguistsImage,
  volumeTechnologyImage,
  volumeMusicImage,
  volumeChoreImage,
] = await Promise.all([
  getImage({ src: heroSource, width: 1920, format: 'webp', quality: 78 }),
  getImage({ src: volumeAnimeSource, width: 1920, format: 'webp', quality: 78 }),
  getImage({ src: volumeMusicSource, width: 1920, format: 'webp', quality: 78 }),
  getImage({ src: latestPostsSource, width: 1200, format: 'webp', quality: 70 }),
  getImage({ src: volumePaperNotesSource, width: 900, format: 'webp', quality: 72 }),
  getImage({ src: volumeAnimeSource, width: 900, format: 'webp', quality: 72 }),
  getImage({ src: volumeLinguistsSource, width: 900, format: 'webp', quality: 72 }),
  getImage({ src: volumeTechnologySource, width: 900, format: 'webp', quality: 72 }),
  getImage({ src: volumeMusicSource, width: 900, format: 'webp', quality: 72 }),
  getImage({ src: volumeChoreSource, width: 900, format: 'webp', quality: 72 }),
]);
const heroSlides = [
  heroAnimeImage.src,
  heroImage.src,
  heroMusicImage.src,
];
const allPosts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const latestPostsLimit = 8;
const latestPosts = allPosts.slice(0, latestPostsLimit);
const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));
const tagCount = allTags.length;
const totalMinutes = allPosts.reduce((sum, post) => sum + readingTime(post), 0);
const searchItems = toSearchItems(allPosts, locale);

const volumePriority = ['Paper Notes', 'Anime', 'Linguists', 'Technology', 'Music', 'Chore'];
const volumeHref = (tag: string) => localizedPath(locale, `/posts/?volume=${encodeURIComponent(tag)}`);

const volumes = [
  {
    title: 'Paper Notes',
    image: volumePaperNotesImage.src,
    description: t.home.volumes.paperNotes,
    href: volumeHref('Paper Notes'),
  },
  {
    title: 'Anime',
    image: volumeAnimeImage.src,
    description: t.home.volumes.anime,
    href: volumeHref('Anime'),
  },
  {
    title: 'Linguists',
    image: volumeLinguistsImage.src,
    description: t.home.volumes.linguists,
    href: volumeHref('Linguists'),
  },
  {
    title: 'Technology',
    image: volumeTechnologyImage.src,
    description: t.home.volumes.technology,
    href: volumeHref('Technology'),
  },
  {
    title: 'Music',
    image: volumeMusicImage.src,
    description: t.home.volumes.music,
    href: volumeHref('Music'),
  },
  {
    title: 'Chore',
    image: volumeChoreImage.src,
    description: t.home.volumes.chore,
    href: volumeHref('Chore'),
  },
];

const featuredVolumes = volumePriority
  .map((title) => volumes.find((volume) => volume.title === title))
  .filter((volume): volume is (typeof volumes)[number] => Boolean(volume));
const moreVolumes = volumes.filter((volume) => !volumePriority.includes(volume.title));

const socialLinks = [
  {
    name: 'GitHub',
    meta: 'Code / Repo',
    initials: 'GH',
    avatar: '/images/social/github-avatar.webp',
    label: 'github.com/mugaaaaa',
    href: 'https://github.com/mugaaaaa',
    text: t.home.socials.github,
  },
  {
    name: 'QQ',
    meta: 'Chat',
    initials: 'QQ',
    avatar: '/images/social/qq-avatar.webp',
    label: 'QQ 2650009090',
    href: 'tencent://message/?uin=2650009090&Site=MugaaaaaBlog&Menu=yes',
    text: t.home.socials.qq,
  },
  {
    name: 'Bilibili',
    meta: 'Video / Feed',
    initials: 'BL',
    avatar: '/images/social/bilibili-avatar.webp',
    label: 'space.bilibili.com/402171062',
    href: 'https://space.bilibili.com/402171062?spm_id_from=333.1007.0.0',
    text: t.home.socials.bilibili,
  },
  {
    name: 'Reserved',
    meta: 'Open Slot',
    initials: '+',
    avatar: '',
    label: 'To be added',
    href: '',
    text: t.home.socials.reserved,
  },
];

const progressSections = [
  { id: 'top', label: 'Hero' },
  { id: 'volume', label: t.nav.volume },
  { id: 'notes', label: t.nav.posts },
  { id: 'socials', label: t.nav.socials },
];
const endQuotePlain = t.home.endQuote.map((part) => part.text).join('');
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={t.home.metaDescription}
    />
    <title>Mugaaaaa's Blog</title>
  </head>
  <body>
    <div id="top" class="min-h-screen overflow-x-hidden">
      <FloatingGlass locale={locale} currentPath={currentPath} client:load />
      <MobileGlassDock locale={locale} client:load />
      <CommandPalette posts={searchItems} locale={locale} client:load />
      <ProgressGlass sections={progressSections} client:load />
      <NowQueueGlass
        currentTitle={latestPosts[0]?.data.title ?? t.nowQueue.draftFallback}
        nextTitle={latestPosts[1]?.data.title}
        postCount={allPosts.length}
        tagCount={tagCount}
        locale={locale}
        client:load
      />

      <header class="hero-screen hero-carousel relative isolate min-h-screen min-h-[100svh] overflow-hidden bg-stone-950 text-white" data-hero-carousel>
        <div class="hero-carousel-track no-scrollbar absolute inset-0 z-0 flex snap-x snap-mandatory overflow-x-auto" data-hero-track aria-hidden="true">
          {heroSlides.map((slide, index) => (
            <div
              data-hero-slide
              data-active={index === 0 ? 'true' : 'false'}
              class="hero-carousel-slide relative h-full w-full shrink-0 snap-start"
            >
              <img
                src={slide}
                alt=""
                loading={index === 0 ? undefined : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
                class="h-full w-full object-cover object-top"
              />
            </div>
          ))}
        </div>
        <div class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.78),rgba(0,0,0,0.2)_48%,rgba(0,0,0,0.68))]"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-36 bg-gradient-to-t from-black/58 to-transparent"></div>
        <div class="hero-carousel-arrow-shell hero-carousel-arrow-left" data-hero-prev-shell hidden>
          <LiquidGlass
            className="hero-carousel-arrow-glass pointer-events-auto rounded-full p-1 text-stone-950 shadow-[0_24px_70px_-42px_rgba(0,0,0,0.86)]"
            chroma={0.34}
            blur={2.4}
            distort={30}
            bezelRatio={0.88}
            tintColor="#ffffff"
            tintAlpha={0.3}
            saturate={150}
            client:load
          >
            <button type="button" class="hero-carousel-arrow-button" aria-label="Previous hero image" data-hero-prev>
              ‹
            </button>
          </LiquidGlass>
        </div>
        <div class="hero-carousel-arrow-shell hero-carousel-arrow-right" data-hero-next-shell>
          <LiquidGlass
            className="hero-carousel-arrow-glass pointer-events-auto rounded-full p-1 text-stone-950 shadow-[0_24px_70px_-42px_rgba(0,0,0,0.86)]"
            chroma={0.34}
            blur={2.4}
            distort={30}
            bezelRatio={0.88}
            tintColor="#ffffff"
            tintAlpha={0.3}
            saturate={150}
            client:load
          >
            <button type="button" class="hero-carousel-arrow-button" aria-label="Next hero image" data-hero-next>
              ›
            </button>
          </LiquidGlass>
        </div>
        <div class="pointer-events-none relative z-20 mx-auto flex min-h-screen min-h-[100svh] max-w-7xl flex-col justify-end px-5 pb-8 pt-28 md:px-8 lg:px-10 lg:pr-56">
          <div class="max-w-6xl">
            <p class="mb-5 inline-flex border border-white/45 bg-white px-3 py-1 text-xs font-black uppercase text-stone-950">
              {t.home.eyebrow}
            </p>
            <h1 class="hero-title max-w-6xl font-black uppercase">
              Mugaaaaa's<br />
              Blog
            </h1>
            <div class="mt-6 grid min-w-0 gap-5 md:grid-cols-[minmax(0,620px)_minmax(220px,1fr)] md:items-end">
              <p class="hero-subtitle max-w-2xl font-black leading-8 text-white/90">
                {t.home.heroSubtitle}
              </p>
              <LiquidGlass
                className="hidden w-full min-w-0 grid-cols-3 gap-1 rounded-full px-2 py-2 text-center text-white shadow-[0_24px_80px_-42px_rgba(0,0,0,0.86)] md:grid"
                chroma={0.36}
                blur={2.4}
                distort={28}
                bezelRatio={0.88}
                tintColor="#ffffff"
                tintAlpha={0.3}
                saturate={155}
                client:load
              >
                <div class="rounded-full bg-stone-950 px-4 py-2 text-white">
                  <p class="text-3xl font-black tabular-nums">{allPosts.length}</p>
                  <p class="text-xs font-bold text-white/72">{t.common.posts}</p>
                </div>
                <div class="rounded-full bg-stone-950 px-4 py-2 text-white">
                  <p class="text-3xl font-black tabular-nums">{tagCount}</p>
                  <p class="text-xs font-bold text-white/72">{t.common.tags}</p>
                </div>
                <div class="rounded-full bg-stone-950 px-4 py-2 text-white">
                  <p class="text-3xl font-black tabular-nums">{totalMinutes}</p>
                  <p class="text-xs font-bold text-white/72">{t.common.min}</p>
                </div>
              </LiquidGlass>
            </div>
          </div>
        </div>
      </header>

      <main>
        <section id="volume" class="border-y border-stone-300 bg-[#edf5f4] py-16">
          <div class="mx-auto max-w-7xl px-5 md:px-8 lg:px-10">
            <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <h2 class="section-title font-black uppercase">{t.nav.volume}</h2>
              <p class="max-w-md font-semibold leading-7 text-[var(--muted)]">
                {t.home.volumeIntro}
              </p>
            </div>
          </div>
          <div class="volume-shell relative" data-volume-shell data-home-track-shell>
            <div class="volume-rail no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-1" data-volume-rail data-home-track-rail>
              {featuredVolumes.map((volume, index) => (
                <article class="volume-card flat-card shrink-0 snap-start overflow-hidden" data-home-track-card>
                  <a href={volume.href} class="block h-full">
                    <div class="aspect-[5/4] bg-stone-200">
                      <img src={volume.image} alt={volume.title} loading="lazy" decoding="async" class="image-cover" />
                    </div>
                    <div class="p-4">
                      <p class="mb-2 text-xs font-black uppercase text-stone-500">{t.nav.volume} 0{index + 1}</p>
                      <h3 class="text-lg font-black">{volume.title}</h3>
                      <p class="mt-2 text-sm font-semibold leading-6 text-stone-600">{volume.description}</p>
                    </div>
                  </a>
                </article>
              ))}
            </div>
            <div class="pointer-events-none absolute inset-x-0 top-1/2 z-20 hidden -translate-y-1/2 md:block">
              <div class="mx-auto flex max-w-7xl justify-between px-5 md:px-8 lg:px-10">
                <div data-volume-prev data-home-track-prev hidden>
                  <LiquidGlass
                    className="volume-pager pointer-events-auto rounded-full p-1 text-stone-950 shadow-[0_28px_90px_-34px_rgba(0,0,0,0.86)]"
                    chroma={0.34}
                    blur={2.4}
                    distort={30}
                    bezelRatio={0.88}
                    tintColor="#ffffff"
                    tintAlpha={0.3}
                    saturate={150}
                    client:load
                  >
                    <button
                      type="button"
                      class="grid h-24 w-12 cursor-pointer place-items-center rounded-full text-4xl font-black leading-none text-stone-950 transition"
                      aria-label="Previous volumes"
                    >
                      ‹
                    </button>
                  </LiquidGlass>
                </div>
                <div data-volume-next data-home-track-next hidden class="ml-auto">
                  <LiquidGlass
                    className="volume-pager pointer-events-auto rounded-full p-1 text-stone-950 shadow-[0_28px_90px_-34px_rgba(0,0,0,0.86)]"
                    chroma={0.34}
                    blur={2.4}
                    distort={30}
                    bezelRatio={0.88}
                    tintColor="#ffffff"
                    tintAlpha={0.3}
                    saturate={150}
                    client:load
                  >
                    <button
                      type="button"
                      class="grid h-24 w-12 cursor-pointer place-items-center rounded-full text-4xl font-black leading-none text-stone-950 transition"
                      aria-label="Next volumes"
                    >
                      ›
                    </button>
                  </LiquidGlass>
                </div>
              </div>
            </div>
          </div>
          <div class="mx-auto max-w-7xl px-5 md:px-8 lg:px-10">
            {moreVolumes.length > 0 && (
              <div class="mt-4 flat-card p-4">
                <p class="text-xs font-black uppercase text-stone-500">More</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {moreVolumes.map((volume) => (
                    <a href={volume.href} class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black uppercase text-stone-700 hover:border-stone-950">
                      {volume.title}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>

        <section id="notes" class="relative isolate overflow-hidden border-b border-stone-900 bg-stone-950 py-16 text-white">
          <img
            src={latestPostsImage.src}
            alt=""
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
          />
          <div class="absolute inset-0 -z-10 bg-black/56"></div>
          <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(0,0,0,0.32),rgba(0,0,0,0.68))]"></div>
          <div class="mx-auto max-w-7xl px-5 md:px-8 lg:px-10">
            <div class="mb-10 grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
              <div>
                <h2 class="section-title font-black uppercase">{t.home.latestTitle}</h2>
                <p class="mt-5 max-w-2xl font-semibold leading-7 text-white/76">
                  {t.home.latestIntro}
                </p>
              </div>
              <LiquidGlass
                className="w-fit rounded-full px-1 py-1 text-white shadow-[0_24px_70px_-38px_rgba(0,0,0,0.9)] md:justify-self-end"
                chroma={0.28}
                blur={2.2}
                distort={22}
                bezelRatio={0.88}
                tintColor="#ffffff"
                tintAlpha={0.3}
                saturate={130}
                client:load
              >
                <a href={localizedPath(locale, '/posts/')} class="inline-flex rounded-full px-5 py-3 text-sm font-black uppercase text-white">
                  {t.home.viewAllPosts}
                </a>
              </LiquidGlass>
            </div>
            <PostFilterGlass tags={allTags} baseHref={localizedPath(locale, '/posts/')} tone="dark" locale={locale} client:load />
          </div>
          <div class="volume-shell relative" data-latest-posts-track data-home-track-shell>
            <div class="volume-rail no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-1" data-home-track-rail>
              {latestPosts.map((post, index) => (
                <article class="volume-card flat-card flex min-h-[320px] shrink-0 snap-start p-5 text-stone-950 transition hover:-translate-y-1 hover:border-stone-950" data-home-track-card>
                  <a href={postHref(post, locale)} class="block h-full">
                    <div class="mb-8 flex items-center justify-between gap-4">
                      <span class="border border-stone-950 px-2 py-1 text-xs font-black uppercase text-stone-950">
                        {post.data.category ?? t.common.note}
                      </span>
                      <time class="text-sm font-bold text-stone-500" datetime={post.data.published.toISOString()}>
                        {formatDate(post.data.published, locale)}
                      </time>
                    </div>
                    <h3 class="text-2xl font-black leading-tight">{post.data.title}</h3>
                    <p class="mt-4 text-sm font-semibold leading-6 text-stone-600">
                      {post.data.description || t.common.fallbackDescription}
                    </p>
                    <div class="mt-8 flex flex-wrap gap-2">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="bg-stone-100 px-2 py-1 text-[11px] font-black uppercase text-stone-600">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </a>
                </article>
              ))}
            </div>
            <div class="pointer-events-none absolute inset-x-0 top-1/2 z-20 hidden -translate-y-1/2 md:block">
              <div class="mx-auto flex max-w-7xl justify-between px-5 md:px-8 lg:px-10">
                <div data-home-track-prev hidden>
                  <LiquidGlass
                    className="volume-pager pointer-events-auto rounded-full p-1 text-stone-950 shadow-[0_28px_90px_-34px_rgba(0,0,0,0.9)]"
                    chroma={0.34}
                    blur={2.4}
                    distort={30}
                    bezelRatio={0.88}
                    tintColor="#ffffff"
                    tintAlpha={0.3}
                    saturate={150}
                    client:load
                  >
                    <button
                      type="button"
                      class="grid h-24 w-12 cursor-pointer place-items-center rounded-full text-4xl font-black leading-none text-stone-950 transition"
                      aria-label="Previous latest posts"
                    >
                      ‹
                    </button>
                  </LiquidGlass>
                </div>
                <div data-home-track-next hidden class="ml-auto">
                  <LiquidGlass
                    className="volume-pager pointer-events-auto rounded-full p-1 text-stone-950 shadow-[0_28px_90px_-34px_rgba(0,0,0,0.9)]"
                    chroma={0.34}
                    blur={2.4}
                    distort={30}
                    bezelRatio={0.88}
                    tintColor="#ffffff"
                    tintAlpha={0.3}
                    saturate={150}
                    client:load
                  >
                    <button
                      type="button"
                      class="grid h-24 w-12 cursor-pointer place-items-center rounded-full text-4xl font-black leading-none text-stone-950 transition"
                      aria-label="Next latest posts"
                    >
                      ›
                    </button>
                  </LiquidGlass>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="socials" class="paper-grid px-5 py-16 md:px-8 lg:px-10">
          <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <div>
              <h2 class="section-title font-black uppercase">{t.nav.socials}</h2>
              <p class="mt-5 max-w-xl font-semibold leading-7 text-[var(--muted)]">
                {t.home.socialsIntro}
              </p>
              </div>
              <p class="max-w-sm text-sm font-bold leading-6 text-stone-500">
                {t.home.socialsList}
              </p>
            </div>
            <div class="grid max-w-4xl gap-4 sm:grid-cols-2">
              {socialLinks.map((social, index) => (
                <article class="flat-card p-4 text-stone-950">
                  <div class="mb-4 flex items-center justify-between gap-4">
                    <div class="flex gap-1.5" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
                      <span class="size-2.5 rounded-full bg-[#ffbd2e]"></span>
                      <span class="size-2.5 rounded-full bg-[#28c840]"></span>
                    </div>
                    <span class="text-[10px] font-black uppercase text-stone-400">0{index + 1}</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="grid size-14 shrink-0 place-items-center overflow-hidden rounded-full border border-stone-300 bg-stone-100 text-sm font-black text-stone-500">
                      {social.avatar ? (
                        <img src={social.avatar} alt={`${social.name} avatar`} class="h-full w-full object-cover" />
                      ) : (
                        social.initials
                      )}
                    </div>
                    <div class="min-w-0">
                      <p class="text-[11px] font-black uppercase text-stone-500">{social.meta}</p>
                      <h3 class="mt-1 truncate text-2xl font-black leading-none">{social.name}</h3>
                    </div>
                  </div>
                  <p class="mt-4 min-h-12 text-sm font-semibold leading-6 text-stone-600">{social.text}</p>
                  {social.href ? (
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noreferrer"
                      class="mt-4 inline-flex max-w-full rounded-full border border-stone-950 px-3 py-2 text-xs font-black uppercase text-stone-950"
                    >
                      {social.label}
                    </a>
                  ) : (
                    <p class="mt-4 inline-flex max-w-full rounded-full border border-stone-300 px-3 py-2 text-xs font-black uppercase text-stone-600">
                      {social.label}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="bg-[var(--ink)] px-5 py-20 text-[var(--paper)] md:px-8 lg:px-10">
          <div class="mx-auto flex min-h-[260px] max-w-7xl flex-col items-center justify-center text-center">
            <p class="mb-8 inline-flex bg-[var(--gold)] px-3 py-1 text-xs font-black uppercase text-stone-950">
              {t.home.endLabel}
            </p>
            <p class="end-quote text-4xl font-black leading-[2.2] md:text-6xl" aria-label={endQuotePlain}>
              {t.home.endQuote.map((part) => (
                part.ruby ? (
                  <ruby>{part.text}<rt>{part.ruby}</rt></ruby>
                ) : (
                  <span>{part.text}</span>
                )
              ))}
            </p>
          </div>
        </section>
      </main>
    </div>
    <script>
      import { bindHeroImageCarousel } from '../../lib/hero-carousel.js';
      import { bindHomePageInteractions } from '../../lib/home-interactions.js';

      const startHomePageInteractions = () => {
        bindHeroImageCarousel();
        bindHomePageInteractions();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startHomePageInteractions, { once: true });
      } else {
        startHomePageInteractions();
      }
      document.addEventListener('astro:page-load', startHomePageInteractions);
    </script>
  </body>
</html>
